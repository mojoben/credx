# Environment variables for the Coolify application (Configuration > Environment Variables).
# Nothing here is needed at build time: they are read by the server when a form is sent.

# Resend (the same account as credco.co.uk). credx.co.uk must be verified in Resend first,
# because the domain's DMARC policy is p=reject. Without a key, enquiries are logged, not sent.
RESEND_API_KEY=

# Who the enquiry goes to, and who it's from (must be on the verified domain).
MAIL_TO=info@credx.co.uk
MAIL_FROM=info@credx.co.uk
MAIL_FROM_NAME=Credx

# reCAPTCHA secret key, from the reCAPTCHA admin (it pairs with the site key in
# src/lib/config.ts). If it's missing or wrong, enquiries still go through and the log says why.
RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5
# Only if RECAPTCHA_MODE is switched to 'enterprise' in src/lib/config.ts, instead of the secret:
# RECAPTCHA_PROJECT_ID=
# RECAPTCHA_API_KEY=

# Optional
# AUTOREPLY=off          # stop the confirmation email to the person enquiring
# RATE_LIMIT=10          # enquiries per IP address per hour
# ENQUIRY_LOG_DIR=/data  # where credx-enquiries.csv is written (set in the Dockerfile)
# SITE_URL=https://credx.co.uk   # used for the logo and font in the emails
