---
// Font Awesome 7 Free solid glyphs used by the old theme, as inline SVG (traced from fa-solid-900).
const ICONS = {
  'arrow-left': [512, 'M9 233C-3 246-3 266 9 279L169 439C182 451 202 451 215 439C227 426 227 406 215 393L109 288L480 288C498 288 512 274 512 256C512 238 498 224 480 224L109 224L215 119C227 106 227 86 215 73C202 61 182 61 169 73L9 233Z'],
  'arrow-right': [512, 'M503 279C515 266 515 246 503 233L343 73C330 61 310 61 297 73C285 86 285 106 297 119L403 224L32 224C14 224 0 238 0 256C0 274 14 288 32 288L403 288L297 393C285 406 285 426 297 439C310 451 330 451 343 439L503 279Z'],
  bars: [448, 'M0 96C0 78 14 64 32 64L416 64C434 64 448 78 448 96C448 114 434 128 416 128L32 128C14 128 0 114 0 96ZM0 256C0 238 14 224 32 224L416 224C434 224 448 238 448 256C448 274 434 288 416 288L32 288C14 288 0 274 0 256ZM448 416C448 434 434 448 416 448L32 448C14 448 0 434 0 416C0 398 14 384 32 384L416 384C434 384 448 398 448 416Z'],
  xmark: [384, 'M55 73C43 61 22 61 10 73C-3 86-3 106 10 119L147 256L10 393C-3 406-3 426 10 439C22 451 43 451 55 439L193 301L330 439C342 451 363 451 375 439C388 426 388 406 375 393L238 256L375 119C388 106 388 86 375 73C363 61 342 61 330 73L193 211L55 73Z'],
} as const;

interface Props {
  name: keyof typeof ICONS;
  class?: string;
}
const { name, class: cls } = Astro.props;
const [w, d] = ICONS[name];
// FA7 icons are fixed-width (1.25em) with the glyph centred
---
<svg class:list={['icon', cls]} viewBox={`${(w - 640) / 2} 0 640 512`} aria-hidden="true" focusable="false"><path d={d} /></svg>
