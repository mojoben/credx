---
import Base from '../layouts/Base.astro';
---
<Base page="404" path="/404/" title="Page not found - Credx" noindex>
  <main class="not-found">
    <div class="container">
      <h1>Page not found</h1>
      <p>Sorry, we couldn’t find that page. It may have moved when we updated the site.</p>
      <a class="thm-btn" href="/">Back to the home page</a>
    </div>
  </main>
</Base>
