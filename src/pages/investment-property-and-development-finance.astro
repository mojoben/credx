---
import Base from '../layouts/Base.astro';
import AboutIntro from '../components/AboutIntro.astro';
import Points from '../components/Points.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import WhyBridging from '../components/WhyBridging.astro';
import ContactSection from '../components/ContactSection.astro';
import { getPage } from '../lib/content';

const p = getPage('investment');
const f = p.fields;
---
<Base page="investment" path={p.path} crumb={p.title}>
  <main>
    <AboutIntro title={f.banner_title} html={p.content} image1={f.banner_image_1} image2={f.banner_image_2} />
    <Points title={f.key_benefits_title} points={f.key_benefits_points} />
    <ProcessSteps title={f.bridging_finance_works_with_credx_title} steps={f.bridging_finance_works_with_credx_data_box} />
    <Points title={f.bridging_finance_used_title} points={f.bridging_finance_used_points} />
    <WhyBridging title={f.why_choose_residential_bridging_title} button="Speak to a Specialist Today" dark cols={8} list={f.why_choose_residential_bridging_points} />
    <ContactSection intro={f.form_intro_text} />
  </main>
</Base>
